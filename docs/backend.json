{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the application.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "resumeUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the user's resume PDF in Firebase Storage."
        }
      },
      "required": ["displayName", "email"]
    },
    "Skill": {
      "title": "Skill",
      "description": "A technical skill possessed by the user.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the skill."
        }
      },
      "required": ["name"]
    },
    "Project": {
      "title": "Project",
      "description": "A project entry in the user's portfolio.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "tools": {
          "type": "string"
        },
        "outcomes": {
          "type": "string"
        }
      },
      "required": ["title", "problem", "tools", "outcomes"]
    },
    "Experience": {
      "title": "Experience",
      "description": "An experience entry (work, education, or certification) in the user's portfolio.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["work", "education", "certification"]
        },
        "title": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["type", "title", "company", "duration", "description"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/users/{userId}/skills/{skillId}": {
      "schema": {
        "$ref": "#/entities/Skill"
      },
      "description": "A user's list of skills."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "A user's list of projects."
    },
    "/users/{userId}/experience/{experienceId}": {
      "schema": {
        "$ref": "#/entities/Experience"
      },
      "description": "A user's list of experience entries."
    }
  }
}
